    // Rich editor
    private string selectedHeading = "p";
    private bool uploadingMainPicture = false;
    private bool uploadingFiles = false;

    // Video modal
    private bool _showVideoModal;
    private int _videoTabIndex;
    private string _videoUrlInput = "";
    private bool _uploadingVideo;
    private double _uploadProgress = -1;
    private string? _videoUploadError;
    private IBrowserFile? _selectedVideoFile;

