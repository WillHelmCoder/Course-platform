    // Video helpers
    private bool IsYouTubeUrl(string? url) =>
        !string.IsNullOrEmpty(url) && (url.Contains("youtube.com") || url.Contains("youtu.be"));

    private bool IsVimeoUrl(string? url) =>
        !string.IsNullOrEmpty(url) && url.Contains("vimeo.com");

    private string GetYouTubeEmbedUrl(string? url)
    {
        if (string.IsNullOrEmpty(url)) return "";
        try
        {
            var videoId = "";
            if (url.Contains("v="))
            {
                var start = url.IndexOf("v=") + 2;
                var end = url.IndexOf("&", start);
                videoId = end > 0 ? url.Substring(start, end - start) : url.Substring(start);
            }
            else if (url.Contains("youtu.be/"))
            {
                var start = url.IndexOf("youtu.be/") + 9;
                var end = url.IndexOf("?", start);
                videoId = end > 0 ? url.Substring(start, end - start) : url.Substring(start);
            }
            return string.IsNullOrEmpty(videoId) ? url : $"https://www.youtube.com/embed/{videoId}";
        }
        catch
        {
            return url ?? "";
        }
    }

    private string GetVimeoEmbedUrl(string? url)
    {
        if (string.IsNullOrEmpty(url)) return "";
        try
        {
            var videoId = url.Split('/').LastOrDefault() ?? "";
            return string.IsNullOrEmpty(videoId) ? url : $"https://player.vimeo.com/video/{videoId}";
        }
        catch
        {
            return url ?? "";
        }
    }

    // File handling
    private async Task OnMainPictureSelected(IBrowserFile file)
    {
        if (file == null) return;
        uploadingMainPicture = true;
        StateHasChanged();

        try
        {
            var imageUrl = await Api.UploadImageAsync(file);
            if (imageUrl != null)
            {
                editModel.MainPicture = imageUrl;
                Snackbar.Add("Image uploaded", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            uploadingMainPicture = false;
            StateHasChanged();
        }
    }

    private async Task OnFilesSelected(IReadOnlyList<IBrowserFile> files)
    {
        if (files == null || !files.Any() || !ContentId.HasValue) return;

        uploadingFiles = true;
        StateHasChanged();

        try
        {
            foreach (var file in files)
            {
                var attachment = await Api.UploadContentAttachmentAsync(ContentId.Value, file);
                if (attachment != null)
                {
                    editModel.Attachments.Add(attachment);
                }
            }
            Snackbar.Add($"{files.Count} file(s) uploaded", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            uploadingFiles = false;
            StateHasChanged();
        }
    }

    private async Task DeleteAttachment(ContentAttachmentDto attachment)
    {
        var deleted = await Api.DeleteContentAttachmentAsync(attachment.Id);
        if (deleted)
        {
            editModel.Attachments.Remove(attachment);
            Snackbar.Add("Attachment deleted", Severity.Success);
        }
        else
        {
            Snackbar.Add("Failed to delete attachment", Severity.Error);
        }
    }

    private string GetFileIcon(string contentType) => contentType switch
    {
        "application/pdf" => Icons.Custom.FileFormats.FilePdf,
        "application/msword" or "application/vnd.openxmlformats-officedocument.wordprocessingml.document" => Icons.Custom.FileFormats.FileWord,
        "application/vnd.ms-excel" or "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" => Icons.Custom.FileFormats.FileExcel,
        "application/vnd.ms-powerpoint" or "application/vnd.openxmlformats-officedocument.presentationml.presentation" => Icons.Material.Filled.Slideshow,
        _ => Icons.Material.Filled.InsertDriveFile
    };

    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    // Video modal methods
    private void OpenVideoModal()
    {
        _videoTabIndex = 0;
        _videoUrlInput = "";
        _videoUploadError = null;
        _uploadProgress = -1;
        _selectedVideoFile = null;
        _showVideoModal = true;
    }

    private void CloseVideoModal()
    {
        _showVideoModal = false;
        _videoUploadError = null;
        _uploadProgress = -1;
        _selectedVideoFile = null;
    }

    private void ApplyVideoUrl()
    {
        if (!string.IsNullOrWhiteSpace(_videoUrlInput))
        {
            editModel.VideoUrl = _videoUrlInput;
            CloseVideoModal();
        }
    }

    private async Task OnVideoFileSelected(IBrowserFile file)
    {
        if (file == null) return;

        _selectedVideoFile = file;
        _videoUploadError = null;

        // Validate file size
        if (file.Size > 500 * 1024 * 1024)
        {
            _videoUploadError = "File size exceeds 500MB limit";
            return;
        }

        // Validate file type
        var allowedTypes = new[] { "video/mp4", "video/webm", "video/quicktime" };
        if (!allowedTypes.Contains(file.ContentType.ToLower()))
        {
            _videoUploadError = "Only MP4, WebM, and MOV files are allowed";
            return;
        }

        _uploadingVideo = true;
        _uploadProgress = 0;
        StateHasChanged();

        try
        {
            var videoUrl = await Api.UploadVideoAsync(file, (bytesRead, totalBytes) =>
            {
                _uploadProgress = (double)bytesRead / totalBytes * 100;
                InvokeAsync(StateHasChanged);
            });

            if (videoUrl != null)
            {
                editModel.VideoUrl = videoUrl;
                Snackbar.Add("Video uploaded successfully!", Severity.Success);
                CloseVideoModal();
            }
            else
            {
                _videoUploadError = "Failed to upload video. Please try again.";
            }
        }
        catch (Exception ex)
        {
            _videoUploadError = $"Upload error: {ex.Message}";
        }
        finally
        {
            _uploadingVideo = false;
            StateHasChanged();
        }
    }

    private async Task RemoveVideo()
    {
        if (!string.IsNullOrEmpty(editModel.VideoUrl))
        {
            // If it's an uploaded video, delete it from server
            if (IsUploadedVideo(editModel.VideoUrl))
            {
                await Api.DeleteVideoAsync(editModel.VideoUrl);
            }
            editModel.VideoUrl = null;
            Snackbar.Add("Video removed", Severity.Info);
        }
    }

    private bool IsUploadedVideo(string? url) =>
        !string.IsNullOrEmpty(url) && url.StartsWith("/uploads/videos/");
}
