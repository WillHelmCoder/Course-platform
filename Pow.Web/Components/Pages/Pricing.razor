@page "/pricing"
@using MudBlazor
@using Pow.Domain.DTOs
@inject ApiService Api
@inject NavigationManager Nav

<PageTitle>Pricing - Pow</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
    <MudText Typo="Typo.h3" Align="Align.Center" Class="mb-2">Simple, Transparent Pricing</MudText>
    <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Secondary" Class="mb-6">
        Choose the plan that's right for you. Start free, upgrade when you're ready.
    </MudText>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_plans.Count == 0)
    {
        <MudAlert Severity="Severity.Info">No plans available at the moment.</MudAlert>
    }
    else
    {
        <MudGrid Justify="Justify.Center" Spacing="4">
            @foreach (var plan in _plans)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard Elevation="@(plan.IsRecommended ? 8 : 2)"
                             Class="@(plan.IsRecommended ? "recommended-plan" : "")"
                             Style="height: 100%;">
                        @if (plan.IsRecommended)
                        {
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small"
                                     Style="position: absolute; top: -10px; right: 16px;">
                                Most Popular
                            </MudChip>
                        }
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h5" Align="Align.Center">@plan.Name</MudText>
                                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                                    @plan.Description
                                </MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <div class="text-center mb-4">
                                @if (plan.Price == 0)
                                {
                                    <MudText Typo="Typo.h3" Color="Color.Primary">Free</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Forever</MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.h3" Color="Color.Primary">
                                        @plan.Currency @plan.Price.ToString("N2")
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        /@plan.Interval
                                    </MudText>
                                }
                            </div>

                            <MudDivider Class="mb-4" />

                            <MudList T="string" Dense="true">
                                @foreach (var feature in plan.Features)
                                {
                                    <MudListItem T="string" Icon="@Icons.Material.Filled.Check" IconColor="Color.Success">
                                        @feature
                                    </MudListItem>
                                }
                                @if (plan.MaxUsers > 0)
                                {
                                    <MudListItem T="string" Icon="@Icons.Material.Filled.People">
                                        Up to @plan.MaxUsers users
                                    </MudListItem>
                                }
                                else
                                {
                                    <MudListItem T="string" Icon="@Icons.Material.Filled.AllInclusive">
                                        Unlimited users
                                    </MudListItem>
                                }
                            </MudList>
                        </MudCardContent>
                        <MudCardActions Class="justify-center pb-4">
                            <MudButton Variant="@(plan.IsRecommended ? Variant.Filled : Variant.Outlined)"
                                       Color="Color.Primary"
                                       Size="Size.Large"
                                       Href="/register">
                                Get Started
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>

        <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary" Class="mt-6">
            Already have an account? <MudLink Href="/login">Sign in</MudLink>
        </MudText>
    }
</MudContainer>

<style>
    .recommended-plan {
        border: 2px solid var(--mud-palette-primary);
        position: relative;
    }
</style>

@code {
    private List<PlanDto> _plans = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _plans = await Api.GetPlansAsync();
        }
        catch
        {
            // Plans may require auth, show empty state
        }
        finally
        {
            _loading = false;
        }
    }
}
