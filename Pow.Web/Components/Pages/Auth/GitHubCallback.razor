@*
    GitHub OAuth Callback Page
    Generated by Diana Integration: github-oauth v2.0.0

    This page handles the OAuth redirect from GitHub after user authorization.
*@
@page "/github-callback"
@using Pow.Web.Services
@inject ApiService Api
@inject AuthStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>GitHub Login - Pow</PageTitle>

<div class="github-callback-container">
    @if (processing)
    {
        <div class="callback-card">
            <div class="spinner-container">
                <div class="spinner"></div>
            </div>
            <h5>Autenticando con GitHub...</h5>
            <p class="text-muted">Por favor espera mientras verificamos tu cuenta.</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="callback-card error">
            <div class="error-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                    <path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 4.995z"/>
                </svg>
            </div>
            <h5>Error de autenticación</h5>
            <p>@errorMessage</p>
            <a href="/login" class="btn btn-primary">Volver al Login</a>
        </div>
    }
</div>

<style>
    .github-callback-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 70vh;
        padding: 2rem;
    }

    .callback-card {
        background: white;
        border-radius: 12px;
        padding: 3rem;
        text-align: center;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        max-width: 400px;
    }

    .callback-card.error {
        border-top: 4px solid #dc3545;
    }

    .spinner-container {
        margin-bottom: 1.5rem;
    }

    .spinner {
        width: 48px;
        height: 48px;
        border: 4px solid #e9ecef;
        border-top-color: #8B5CF6;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin: 0 auto;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    .error-icon {
        color: #dc3545;
        margin-bottom: 1rem;
    }

    .text-muted {
        color: #6c757d;
        font-size: 0.9rem;
    }
</style>

@code {
    private bool processing = true;
    private string? errorMessage;
    private bool _hasProcessed = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _hasProcessed) return;
        _hasProcessed = true;

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var code = query["code"];
        var error = query["error"];
        var errorDescription = query["error_description"];

        if (!string.IsNullOrEmpty(error))
        {
            errorMessage = !string.IsNullOrEmpty(errorDescription)
                ? $"GitHub: {errorDescription}"
                : $"GitHub rechazó la autenticación: {error}";
            processing = false;
            StateHasChanged();
            return;
        }

        if (string.IsNullOrEmpty(code))
        {
            errorMessage = "No se recibió código de autorización de GitHub";
            processing = false;
            StateHasChanged();
            return;
        }

        try
        {
            var result = await Api.GitHubCallbackAsync(code);

            if (result != null && result.Success)
            {
                await AuthState.LoginAsync(result.UserId.ToString(), result.Email);
                Nav.NavigateTo("/", forceLoad: true);
            }
            else
            {
                errorMessage = result?.Error ?? "Error al autenticar con GitHub";
                processing = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error de conexión: {ex.Message}";
            processing = false;
            StateHasChanged();
        }
    }
}
