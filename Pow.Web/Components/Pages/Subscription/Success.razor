@page "/subscription/success"
@inject NavigationManager Nav

<PageTitle>Subscription Successful - Pow</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-8">
    <MudCard Class="pa-8">
        <MudStack AlignItems="AlignItems.Center" Spacing="4">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                     Size="Size.Large"
                     Color="Color.Success"
                     Style="font-size: 80px;" />

            <MudText Typo="Typo.h4" Align="Align.Center">
                Welcome!
            </MudText>

            <MudText Typo="Typo.h6" Align="Align.Center" Color="Color.Success">
                Your subscription is now active
            </MudText>

            <MudText Typo="Typo.body1" Align="Align.Center" Class="mud-text-secondary">
                Thank you for subscribing. You now have full access to all the content included in your plan.
            </MudText>

            <MudDivider Class="my-4" FlexItem="true" Style="width: 100%;" />

            <MudText Typo="Typo.subtitle2" Align="Align.Center" Class="mud-text-secondary">
                What's next?
            </MudText>

            <MudStack Spacing="2" Style="width: 100%;">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           Href="/channels"
                           StartIcon="@Icons.Material.Filled.Explore">
                    Explore Content
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           FullWidth="true"
                           Href="/subscriptions"
                           StartIcon="@Icons.Material.Filled.CreditCard">
                    Manage Subscriptions
                </MudButton>
            </MudStack>

            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-4" Align="Align.Center">
                A confirmation email has been sent to your registered email address.
            </MudText>
        </MudStack>
    </MudCard>
</MudContainer>

@code {
    [SupplyParameterFromQuery]
    public string? SessionId { get; set; }

    protected override void OnInitialized()
    {
        // Session ID can be used for tracking/verification if needed
        if (!string.IsNullOrEmpty(SessionId))
        {
            Console.WriteLine($"Checkout session completed: {SessionId}");
        }
    }
}
