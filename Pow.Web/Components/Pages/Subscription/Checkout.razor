@page "/subscription/checkout/{ChannelPlanId:guid}"
@using Pow.Domain.DTOs
@inject ApiService Api
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Checkout - Pow</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-8">
    @if (loading)
    {
        <MudCard Class="pa-6">
            <MudStack AlignItems="AlignItems.Center" Spacing="4">
                <MudProgressCircular Indeterminate="true" Size="Size.Large" Color="Color.Primary" />
                <MudText Typo="Typo.h6">Preparing checkout...</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    You will be redirected to Stripe to complete your payment.
                </MudText>
            </MudStack>
        </MudCard>
    }
    else if (error != null)
    {
        <MudCard Class="pa-6">
            <MudStack AlignItems="AlignItems.Center" Spacing="4">
                <MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Large" Color="Color.Error" />
                <MudText Typo="Typo.h6">Checkout Error</MudText>
                <MudText Typo="Typo.body1" Class="mud-text-secondary">
                    @error
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/channels">
                    Browse Channels
                </MudButton>
            </MudStack>
        </MudCard>
    }
    else if (plan != null)
    {
        <MudCard Class="pa-6">
            <MudStack Spacing="4">
                <MudText Typo="Typo.h5">Subscribe to @plan.Name</MudText>

                <MudDivider />

                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.body1">Plan</MudText>
                    <MudText Typo="Typo.body1" Style="font-weight: 600;">@plan.Name</MudText>
                </MudStack>

                @if (!string.IsNullOrEmpty(plan.Description))
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        @plan.Description
                    </MudText>
                }

                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.body1">Price</MudText>
                    <MudStack Row="true" AlignItems="AlignItems.Baseline" Spacing="1">
                        <MudText Typo="Typo.h5" Color="Color.Primary">@plan.Currency @plan.Price.ToString("N2")</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">/@GetIntervalLabel(plan.Interval)</MudText>
                    </MudStack>
                </MudStack>

                <MudDivider />

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           Disabled="@redirecting"
                           OnClick="RedirectToStripe">
                    @if (redirecting)
                    {
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
                        <span>Redirecting to Stripe...</span>
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Lock" Class="mr-2" />
                        <span>Pay with Stripe</span>
                    }
                </MudButton>

                <MudText Typo="Typo.caption" Class="mud-text-secondary text-center">
                    Secure payment powered by Stripe. Your payment information is never stored on our servers.
                </MudText>
            </MudStack>
        </MudCard>
    }
</MudContainer>

@code {
    [Parameter]
    public Guid ChannelPlanId { get; set; }

    private ChannelPlanDto? plan;
    private bool loading = true;
    private bool redirecting = false;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await LoadPlan();
    }

    private async Task LoadPlan()
    {
        loading = true;

        // Get plan details
        var plans = await Api.GetChannelPlansAsync(Guid.Empty);

        // We need to find the plan - let's get all channels first
        var channels = await Api.GetPublicChannelsAsync();

        foreach (var channel in channels)
        {
            var channelPlans = await Api.GetChannelPlansAsync(channel.Id);
            plan = channelPlans.FirstOrDefault(p => p.Id == ChannelPlanId);
            if (plan != null) break;
        }

        if (plan == null)
        {
            error = "Plan not found. It may have been removed or is no longer available.";
        }
        else if (plan.Price <= 0)
        {
            error = "This is a free plan. No payment is required.";
        }

        loading = false;
    }

    private async Task RedirectToStripe()
    {
        redirecting = true;

        var baseUrl = Nav.BaseUri.TrimEnd('/');
        var successUrl = $"{baseUrl}/subscription/success";
        var cancelUrl = $"{baseUrl}/content/channels";

        var session = await Api.CreateCheckoutSessionAsync(ChannelPlanId, successUrl, cancelUrl);

        if (session != null)
        {
            Nav.NavigateTo(session.Url, forceLoad: true);
        }
        else
        {
            Snackbar.Add("Failed to create checkout session. Please try again.", Severity.Error);
            redirecting = false;
        }
    }

    private string GetIntervalLabel(string interval) => interval switch
    {
        "monthly" => "month",
        "yearly" => "year",
        "lifetime" => "one-time",
        _ => interval
    };
}
