@page "/feed"
@using Microsoft.AspNetCore.Authorization
@using Pow.Domain.DTOs
@using Pow.Web.Services
@using Pow.Web.Components.Shared
@attribute [Authorize]
@inject ApiService Api
@inject NavigationManager Navigation

<PageTitle>My Feed</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-6">
        <MudText Typo="Typo.h4">My Feed</MudText>
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.RssFeed"
                       Href="/content/channels">
                Discover Channels
            </MudButton>
        </MudStack>
    </MudStack>

    @if (_loading)
    {
        <MudGrid>
            @for (int i = 0; i < 6; i++)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard>
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="180px" />
                        <MudCardContent>
                            <MudSkeleton Width="30%" Height="24px" Class="mb-2" />
                            <MudSkeleton Width="80%" Height="32px" Class="mb-2" />
                            <MudSkeleton Width="100%" Height="48px" />
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
    else if (!_feedItems.Any() && !_follows.Any() && !_subscriptions.Any())
    {
        <MudPaper Class="pa-8 text-center" Elevation="0">
            <MudIcon Icon="@Icons.Material.Filled.RssFeed" Size="Size.Large" Color="Color.Primary" Class="mb-4" Style="font-size: 4rem;" />
            <MudText Typo="Typo.h5" Class="mb-2">Your feed is empty</MudText>
            <MudText Typo="Typo.body1" Class="mud-text-secondary mb-4">
                Follow or subscribe to channels to see their latest content here.
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Explore"
                       Href="/content/channels">
                Explore Channels
            </MudButton>
        </MudPaper>
    }
    else if (!_feedItems.Any())
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            No new content from your followed channels yet. Check back later!
        </MudAlert>

        <MudText Typo="Typo.h6" Class="mb-4">Your Channels</MudText>
        <MudGrid>
            @foreach (var follow in _follows)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard>
                        <MudCardContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                                @if (!string.IsNullOrEmpty(follow.ChannelPicture))
                                {
                                    <MudAvatar Image="@follow.ChannelPicture" Size="Size.Large" />
                                }
                                else
                                {
                                    <MudAvatar Color="Color.Primary" Size="Size.Large">@follow.ChannelName[0]</MudAvatar>
                                }
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.subtitle1">@follow.ChannelName</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Following since @follow.FollowedAt.ToString("MMM dd, yyyy")</MudText>
                                </MudStack>
                            </MudStack>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Text" Color="Color.Primary" Href="@($"/content/channel/{follow.ChannelSlug}")">
                                View Channel
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
    else
    {
        <MudGrid>
            @foreach (var item in _feedItems)
            {
                <MudItem xs="12" sm="6" md="4">
                    <FeedCard Item="@item" />
                </MudItem>
            }
        </MudGrid>

        @if (_hasMore)
        {
            <div class="d-flex justify-center mt-6">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           OnClick="LoadMore"
                           Disabled="_loadingMore">
                    @if (_loadingMore)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    Load More
                </MudButton>
            </div>
        }
    }
</MudContainer>

@code {
    private List<FeedItemDto> _feedItems = new();
    private List<ChannelFollowDto> _follows = new();
    private List<UserSubscriptionDto> _subscriptions = new();
    private bool _loading = true;
    private bool _loadingMore;
    private bool _hasMore = true;
    private int _page = 1;
    private const int PageSize = 12;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;

        var feedTask = Api.GetFeedAsync(_page, PageSize);
        var followsTask = Api.GetMyFollowsAsync();
        var subscriptionsTask = Api.GetMySubscriptionsAsync();

        await Task.WhenAll(feedTask, followsTask, subscriptionsTask);

        _feedItems = await feedTask;
        _follows = await followsTask;
        _subscriptions = await subscriptionsTask;

        _hasMore = _feedItems.Count == PageSize;
        _loading = false;
    }

    private async Task LoadMore()
    {
        _loadingMore = true;
        _page++;

        var newItems = await Api.GetFeedAsync(_page, PageSize);
        _feedItems.AddRange(newItems);
        _hasMore = newItems.Count == PageSize;

        _loadingMore = false;
    }
}
