@page "/admin/users"
@using MudBlazor
@using Pow.Domain.DTOs
@attribute [Authorize(Roles = "SuperAdmin")]
@inject ApiService Api
@inject ISnackbar Snackbar
@inject IDialogService Dialog

<PageTitle>User Management</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
    <MudBreadcrumbs Items="_breadcrumbs" Class="mb-2" />

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h4">User Management</MudText>
    </MudStack>

    <MudPaper Class="pa-4" Elevation="2">
        <MudTable Items="_users" Hover="true" Striped="true" Loading="_loading"
                  QuickFilter="@_quickFilter">
            <ToolBarContent>
                <MudTextField T="string" @bind-Value="_search" Placeholder="Search users..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium" Class="mt-0" Immediate="true" />
            </ToolBarContent>
            <HeaderContent>
                <MudTh>Email</MudTh>
                <MudTh>Roles</MudTh>
                <MudTh>Current Plan</MudTh>
                <MudTh>Plan Expiry</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Email">@context.Email</MudTd>
                <MudTd DataLabel="Roles">
                    @foreach (var role in context.Roles)
                    {
                        <MudChip T="string" Size="Size.Small" Class="mr-1"
                                 Color="@GetRoleColor(role.Name)">@role.Name</MudChip>
                    }
                    @if (!context.Roles.Any())
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">No roles</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Plan">
                    @if (context.CurrentPlan != null)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info">@context.CurrentPlan.Name</MudChip>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">No plan</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Expiry">
                    @if (context.PlanExpiry.HasValue)
                    {
                        @context.PlanExpiry.Value.ToShortDateString()
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">-</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Actions">
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Security"
                               OnClick="() => ManageRoles(context)">
                        Roles
                    </MudButton>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </MudPaper>
</MudContainer>

@code {
    private List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Admin", "/admin"),
        new BreadcrumbItem("Users", null, disabled: true)
    };

    private List<UserMembershipDto> _users = new();
    private List<RoleDto> _roles = new();
    private bool _loading = true;
    private string _search = "";

    private Func<UserMembershipDto, bool> _quickFilter => user =>
    {
        if (string.IsNullOrWhiteSpace(_search)) return true;
        return user.Email.Contains(_search, StringComparison.OrdinalIgnoreCase);
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            _users = await Api.GetAdminUsersAsync();
            _roles = await Api.GetAdminRolesAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private Color GetRoleColor(string roleName) => roleName switch
    {
        "SuperAdmin" => Color.Error,
        "Admin" => Color.Warning,
        "Staff" => Color.Info,
        _ => Color.Default
    };

    private async Task ManageRoles(UserMembershipDto user)
    {
        var parameters = new DialogParameters<UserRolesDialog>
        {
            { x => x.User, user },
            { x => x.AllRoles, _roles }
        };
        var dialog = await Dialog.ShowAsync<UserRolesDialog>("Manage User Roles", parameters);
        var result = await dialog.Result;
        if (!result.Canceled) await LoadDataAsync();
    }
}
