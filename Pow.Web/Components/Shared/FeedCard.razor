@using Pow.Domain.DTOs
@using Pow.Domain.Enums

<MudCard Class="feed-card" Elevation="2">
    @if (!string.IsNullOrEmpty(Item.ContentPicture))
    {
        <MudCardMedia Image="@Item.ContentPicture" Height="180" />
    }
    <MudCardContent>
        <div class="d-flex justify-space-between align-center mb-2">
            <MudChip T="string" Size="Size.Small" Color="@GetAccessColor()">
                @GetAccessLabel()
            </MudChip>
            @if (Item.PublishedAt.HasValue)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    @Item.PublishedAt.Value.ToString("MMM dd, yyyy")
                </MudText>
            }
        </div>
        <MudText Typo="Typo.h6" Class="mb-2">@Item.ContentTitle</MudText>
        @if (!string.IsNullOrEmpty(Item.ContentDescription))
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                @Item.ContentDescription
            </MudText>
        }

        @* Channel & Author info *@
        <MudDivider Class="my-3" />
        <div class="d-flex justify-space-between align-center">
            <MudLink Href="@($"/content/channel/{Item.ChannelSlug}")" Class="d-flex align-center gap-2" Style="text-decoration: none;">
                @if (!string.IsNullOrEmpty(Item.ChannelPicture))
                {
                    <MudAvatar Size="Size.Small" Image="@Item.ChannelPicture" />
                }
                else
                {
                    <MudAvatar Size="Size.Small" Color="Color.Primary">@Item.ChannelName[0]</MudAvatar>
                }
                <MudText Typo="Typo.body2" Color="Color.Primary">@Item.ChannelName</MudText>
            </MudLink>
            @if (Item.AuthorId.HasValue)
            {
                <MudLink Href="@($"/profile/{Item.AuthorId}")" Class="d-flex align-center gap-1" Style="text-decoration: none;">
                    @if (!string.IsNullOrEmpty(Item.AuthorProfilePicture))
                    {
                        <MudAvatar Size="Size.Small" Image="@Item.AuthorProfilePicture" />
                    }
                    else
                    {
                        <MudAvatar Size="Size.Small" Color="Color.Secondary">@((Item.AuthorName ?? "?")[0])</MudAvatar>
                    }
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@Item.AuthorName</MudText>
                </MudLink>
            }
        </div>
    </MudCardContent>
    <MudCardActions>
        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="@($"/read/{Item.ContentSlug}")">
            Read More
        </MudButton>
        <MudSpacer />
        <MudButton Variant="Variant.Text" Size="Size.Small" Href="@($"/content/course/{Item.CourseSlug}")">
            @Item.CourseTitle
        </MudButton>
    </MudCardActions>
</MudCard>

@code {
    [Parameter]
    public FeedItemDto Item { get; set; } = null!;

    private Color GetAccessColor() => Item.AccessLevel switch
    {
        ContentAccessLevel.Public => Color.Success,
        ContentAccessLevel.LoggedIn => Color.Info,
        ContentAccessLevel.AllSubscribers => Color.Warning,
        _ => Color.Default
    };

    private string GetAccessLabel() => Item.AccessLevel switch
    {
        ContentAccessLevel.Public => "Public",
        ContentAccessLevel.LoggedIn => "Members",
        ContentAccessLevel.AllSubscribers => "Subscribers",
        _ => "Unknown"
    };
}

<style>
    .feed-card {
        height: 100%;
        display: flex;
        flex-direction: column;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .feed-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 16px rgba(0,0,0,0.15);
    }

    .feed-card .mud-card-content {
        flex-grow: 1;
    }
</style>
