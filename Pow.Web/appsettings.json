{
  "GitHub": {
    "ClientId": {
      "type": "string",
      "required": true,
      "secret": true,
      "description": "GitHub OAuth App Client ID"
    },
    "ClientSecret": {
      "type": "string",
      "required": true,
      "secret": true,
      "description": "GitHub OAuth App Client Secret"
    },
    "RedirectUri": {
      "type": "string",
      "required": true,
      "default": "https://localhost:{{ports.web}}/github-callback",
      "description": "OAuth callback URL"
    }
  }
}